{
  "name": "@onway/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @onway/contracts gen:client && vite",
    "typecheck": "pnpm --filter @onway/contracts gen:client && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "pnpm --filter @onway/contracts gen:client && vitest run",
    "build": "pnpm --filter @onway/contracts gen:client && tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "pnpm --filter @onway/i18n build && playwright test -c e2e"
  },
  "dependencies": {
    "@onway/contracts": "workspace:*",
    "@onway/i18n": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "i18next": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
