// Mountain walking profile for rescue teams (first pass; the weights are tuned in T5/T6 and documented in the report).
// priority: 1 = neutral, lower = the edge is worse. Values above 1 are not allowed, so "prefer trails" means "penalise roads".
{
  "priority": [
    { "if": "!foot_access", "multiply_by": "0" },
    { "else": "", "multiply_by": "foot_priority" },
    // SAC scale: hike_rating 1 = T1 ... 6 = T6. Rescuers can use T2-T3; T4 and T5 only when nothing else exists.
    { "if": "hike_rating >= 6", "multiply_by": "0" },
    { "else_if": "hike_rating == 5", "multiply_by": "0.3" },
    { "else_if": "hike_rating == 4", "multiply_by": "0.6" },
    // Roads for cars are fine to reach the trailhead, but a trail or track of the same length wins.
    {
      "if": "road_class == PRIMARY || road_class == SECONDARY || road_class == TERTIARY || road_class == RESIDENTIAL || road_class == UNCLASSIFIED || road_class == SERVICE || road_class == LIVING_STREET",
      "multiply_by": "0.5"
    }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" },
    // Same slope slow-downs as the stock foot_elevation.json.
    { "if": "average_slope >= 15", "limit_to": "1.5" },
    { "else_if": "average_slope >= 7", "limit_to": "2.5" },
    { "else_if": "average_slope >= 4", "multiply_by": "0.85" },
    { "else_if": "average_slope <= -4", "multiply_by": "1.05" }
  ]
}
