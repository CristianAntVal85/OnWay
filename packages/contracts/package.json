{
  "name": "@onway/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "source": "./gen/client.ts",
      "types": "./dist/gen/client.d.ts",
      "default": "./dist/gen/client.js"
    }
  },
  "scripts": {
    "typecheck": "pnpm gen:client && tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "gen:doc": "tsx scripts/gen-endpoints-doc.ts",
    "gen:openapi": "tsx scripts/gen-openapi.ts",
    "gen:client": "tsx scripts/gen-client.ts",
    "build": "pnpm gen:client && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
